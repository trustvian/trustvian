{
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go run *)",
      "Bash(go install *)",
      "Bash(go mod *)",
      "Bash(gofmt *)",
      "Bash(make *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(gh api *pending_deployments*)",
      "Bash(git tag*)",
      "Bash(git push *--tags*)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push * v[0-9]*)",
      "Bash(gh api *git/refs*)",
      "Bash(gh api *git/tags*)",
      "Bash(gh release create*)",
      "Bash(gh api -X* *environments*)",
      "Bash(gh api --method* *environments*)",
      "Bash(gh api *environments* -X*)",
      "Bash(gh api *environments* --method*)",
      "Bash(gh api *environments* -f *)",
      "Bash(gh api *environments* -F *)",
      "Bash(gh api *environments* --input*)",
      "Bash(gh api -X* *rulesets*)",
      "Bash(gh api --method* *rulesets*)",
      "Bash(gh api *rulesets* -X*)",
      "Bash(gh api *rulesets* --method*)",
      "Bash(gh api *rulesets* -f *)",
      "Bash(gh api *rulesets* -F *)",
      "Bash(gh api *rulesets* --input*)",
      "Bash(gh pr merge*)",
      "Bash(gh api *releases*)",
      "Bash(gh release edit*)",
      "Bash(gh release upload*)",
      "Bash(gh release delete*)",
      "Bash(gh api graphql*createRef*)",
      "Bash(gh api graphql*updateRef*)",
      "Bash(gh api graphql*deleteRef*)",
      "Bash(gh api *environments* --field*)",
      "Bash(gh api *environments* --raw-field*)",
      "Bash(gh api *rulesets* --field*)",
      "Bash(gh api *rulesets* --raw-field*)",
      "Bash(*release-setup.sh)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.go) gofmt -w \"$f\" ;; esac; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
