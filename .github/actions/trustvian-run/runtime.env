# The runtime the trustvian-run action builds and runs. Reviewed, immutable,
# and changed only by a reviewed pull request — see
# docs/adr/0056-the-run-action-builds-a-pinned-source-commit.md.
#
# Read by lib.sh's load_runtime_pin, which accepts exactly these keys, in this
# form, and nothing else. It is never sourced as shell.
#
# TRUSTVIAN_SOURCE_COMMIT is a full commit of `main`, after pull request #137,
# which is the first commit carrying `trustvian eval run --suite`. No release
# carries `eval run`, `dev` and both helper binaries yet: v0.9.0's archive has
# only `trustvian`, and that binary has neither command.
TRUSTVIAN_SOURCE_REPOSITORY=https://github.com/trustvian/trustvian.git
TRUSTVIAN_SOURCE_COMMIT=576da8fe1f672351271585ca4a5bc9e6eba8ffb6

# The Go toolchain that builds it: the version the v0.9.0 release was built
# with, and the SHA-256 digests go.dev publishes for each archive.
GO_VERSION=1.27.1
GO_SHA256_LINUX_AMD64=63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445
GO_SHA256_LINUX_ARM64=3450b45a3f9ee8568792736a5c5e70a1f2e9b36c35a8f74958c03e51d7d92bec
GO_SHA256_DARWIN_AMD64=8f8f52c6649542cf027bbc9b9c68d1ec042f9f34808a40413f0b8b3f66f3caa4
GO_SHA256_DARWIN_ARM64=ee215d57e0ec269c60cc9ceca68e6bda321ba9ee5afe24f4b0988703c2d87d12
