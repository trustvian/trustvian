# The runtime the trustvian-run and trustvian-comment actions build and run.
# Reviewed, immutable, and changed only by a reviewed pull request — see
# docs/adr/0056-the-run-action-builds-a-pinned-source-commit.md and
# docs/adr/0058-the-comment-job-is-a-separate-action-that-posts-from-pinned-source.md.
#
# Read by lib.sh's load_runtime_pin, which accepts exactly these keys, in this
# form, and nothing else. It is never sourced as shell.
#
# TRUSTVIAN_SOURCE_COMMIT is a full commit of `main`: v0.12.0's, the commit
# the v0.12.0 release was built, verified and tagged at. It was chosen because:
#   - its control plane serves the version 2 report (#168) and its
#     trustvian-ci-render renders it (#170), so a pull request comment carries
#     the sameness, targets, tokens and suggestions sections;
#   - it is a released commit, so the runtime the actions build is a runtime
#     users already run, not an untagged point between releases.
# The previous pin, #140's 5521759, predated v0.10.0 and its runtime wrote
# result document version 1.
#
# The release preflight refuses a release while this pin predates the newest
# stable release (scripts/release-preflight.sh, check 8): moving it is part of
# the follow-ups after every release (docs/release-runbook.md § 5), re-proved
# by the action's end-to-end workflow.
TRUSTVIAN_SOURCE_REPOSITORY=https://github.com/trustvian/trustvian.git
TRUSTVIAN_SOURCE_COMMIT=23beffc7a85db17cc22913769f6357953e88dfa0

# The Go toolchain that builds it, and the SHA-256 digests go.dev publishes
# for each archive. 1.27.2 is the 2026-10-08 security release (the HTTP/2,
# net/http, mime/multipart and crypto/tls advisories in docs/supply-chain.md);
# it was 1.27.1, the version the v0.9.0 release was built with.
GO_VERSION=1.27.2
GO_SHA256_LINUX_AMD64=ecbadb99091a3f46e31f5f934b068b1864eafa7995211b39eaddf76996045fe5
GO_SHA256_LINUX_ARM64=94f3e30b8e374bc285e7dadc11e0865726b9bc6e85b841ccceaabc0214c6b7c8
GO_SHA256_DARWIN_AMD64=587b59182488b23aa6e5fc25110405a3e0e5b38ed2f5b2f46ed13c32aee356fe
GO_SHA256_DARWIN_ARM64=76812b213b1b2302c978d28fa52fa92d541704b9e7d9d5db8002c50e4018c4c5
